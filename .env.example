# Required. Generate with: openssl rand -hex 32
API_AUTH_TOKEN=change-me

# SQLite is the default. Point this at a persistent volume in Docker.
DATABASE_URL=sqlite:///./data/personal_api.db

# Fine-grained GitHub PAT with read-only repository, issues, PR, actions,
# packages and security-events access. Never commit this value.
GITHUB_TOKEN=

# Comma separated organizations to include during discovery.
GITHUB_ORGS=

# Optional public account to discover when no GITHUB_TOKEN is set.
GITHUB_USERNAME=

# Webhook secret configured on the GitHub webhook.
GITHUB_WEBHOOK_SECRET=

# Create tables automatically on startup (local development only; containers use migrations).
AUTO_CREATE_TABLES=true

# Allow registration of arbitrary https remotes (still SSRF-checked).
ALLOW_ARBITRARY_REMOTES=false

# Compose image and host port.
PANOPTICON_IMAGE=ghcr.io/emiliano-go/panopticon:latest
PANOPTICON_PORT=8000
